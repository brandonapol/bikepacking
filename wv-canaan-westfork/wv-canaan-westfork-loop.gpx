<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="quark-project WV bikepacking planner" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata><name>WV Canaan + West Fork 3-Day Loop from Alpena</name></metadata>
  <wpt lat="38.907550" lon="-79.654070">
    <name>Alpena Parking (start/finish)</name>
    <cmt>Trip mi 0.0 (Day 1 start), 101.6 (end Day 2 / start Day 3), 157.4 (finish). Route junction on US-33 at Alpena where the Canaan and West Fork loops meet. Confirm exact lot on arrival. Restock here after Day 2.</cmt>
    <desc>Trip mi 0.0 (Day 1 start), 101.6 (end Day 2 / start Day 3), 157.4 (finish). Route junction on US-33 at Alpena where the Canaan and West Fork loops meet. Confirm exact lot on arrival. Restock here after Day 2.</desc>
    <sym>Parking Area</sym>
  </wpt>
  <wpt lat="38.931552" lon="-79.680563">
    <name>Bear Heaven Campground</name>
    <cmt>Day 1 mi 4.3 / trip mi 4.3. USFS, FR 91 (Stuart Memorial Dr). First come first served, ~$5, vault toilet, NO potable water. Open mid-Apr to Nov. Thu car camp.</cmt>
    <desc>Day 1 mi 4.3 / trip mi 4.3. USFS, FR 91 (Stuart Memorial Dr). First come first served, ~$5, vault toilet, NO potable water. Open mid-Apr to Nov. Thu car camp.</desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="39.007200" lon="-79.549100">
    <name>Gladwin Dispersed Camping</name>
    <cmt>Day 2 mi 37.5 / trip mi 88.5. Free MNF dispersed, Glady Fork / Dry Fork confluence, Gladwin Rd (CR 12). No facilities, pack it out. Filter water.</cmt>
    <desc>Day 2 mi 37.5 / trip mi 88.5. Free MNF dispersed, Glady Fork / Dry Fork confluence, Gladwin Rd (CR 12). No facilities, pack it out. Filter water.</desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="38.978178" lon="-79.590459">
    <name>Lower Glady Dispersed Camping (FR 162)</name>
    <cmt>Day 2 mi 40.8 / trip mi 91.8 (1.2 mi off route). MNF designated dispersed sites on Glady Fork near Milus TH. Coordinates differ by source (DispersedApp 38.978,-79.590; Campendium 38.964,-79.607); verify on MNF map. Filter/boil water (giardia reported).</cmt>
    <desc>Day 2 mi 40.8 / trip mi 91.8 (1.2 mi off route). MNF designated dispersed sites on Glady Fork near Milus TH. Coordinates differ by source (DispersedApp 38.978,-79.590; Campendium 38.964,-79.607); verify on MNF map. Filter/boil water (giardia reported).</desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="38.632427" lon="-79.761830">
    <name>Little River Dispersed Camping (FR 17)</name>
    <cmt>Day 3 mi 27.7 / trip mi 129.3. Several miles of dispersed sites along Little River / FR 17. No facilities or potable water.</cmt>
    <desc>Day 3 mi 27.7 / trip mi 129.3. Several miles of dispersed sites along Little River / FR 17. No facilities or potable water.</desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="38.657642" lon="-79.721595">
    <name>Little River Primitive Campground</name>
    <cmt>Day 3 mi 31.3 / trip mi 132.9. Free, first come first served.</cmt>
    <desc>Day 3 mi 31.3 / trip mi 132.9. Free, first come first served.</desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="38.590200" lon="-79.822600">
    <name>West Fork Dispersed Camping (FR 44)</name>
    <cmt>Day 3 mi 24.7 / trip mi 126.4 (2.0 mi off route). FR 44 dispersed sites north of Durbin along West Fork Greenbrier / Rail Trail. OFF ROUTE: south of Burner turn. Coordinates user-submitted; verify.</cmt>
    <desc>Day 3 mi 24.7 / trip mi 126.4 (2.0 mi off route). FR 44 dispersed sites north of Durbin along West Fork Greenbrier / Rail Trail. OFF ROUTE: south of Burner turn. Coordinates user-submitted; verify.</desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="38.691514" lon="-79.733493">
    <name>Middle Mountain Cabins Hand Pump (WATER)</name>
    <cmt>Day 3 mi 34.5 / trip mi 136.1. Only potable water on the West Fork loop. Cabins are USFS rentals.</cmt>
    <desc>Day 3 mi 34.5 / trip mi 136.1. Only potable water on the West Fork loop. Cabins are USFS rentals.</desc>
    <sym>Drinking Water</sym>
  </wpt>
  <wpt lat="39.093800" lon="-79.673700">
    <name>Food: Parsons</name>
    <cmt>Day 1 mi 33.4 / trip mi 33.4. Groceries and restaurants in Parsons. Last resupply before Blackwater Canyon climb.</cmt>
    <desc>Day 1 mi 33.4 / trip mi 33.4. Groceries and restaurants in Parsons. Last resupply before Blackwater Canyon climb.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="39.149500" lon="-79.497000">
    <name>Food: Thomas</name>
    <cmt>Day 1 mi 47.5 / trip mi 47.5. Cafes/restaurants in Thomas.</cmt>
    <desc>Day 1 mi 47.5 / trip mi 47.5. Cafes/restaurants in Thomas.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="39.128840" lon="-79.463180">
    <name>Food: Davis</name>
    <cmt>Day 1 mi 51.0 / trip mi 51.0. Davis: restaurants, grocery, Blackwater Bikes. End of Day 1 / start of Day 2.</cmt>
    <desc>Day 1 mi 51.0 / trip mi 51.0. Davis: restaurants, grocery, Blackwater Bikes. End of Day 1 / start of Day 2.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="39.116136" lon="-79.489139">
    <name>Blackwater Falls SP Campground</name>
    <cmt>Day 2 mi 1.8 / trip mi 52.8 (0.3 mi off route). State park campground (fee). Dispersed camping NOT allowed in state parks or on private land around Parsons-Thomas-Davis.</cmt>
    <desc>Day 2 mi 1.8 / trip mi 52.8 (0.3 mi off route). State park campground (fee). Dispersed camping NOT allowed in state parks or on private land around Parsons-Thomas-Davis.</desc>
    <sym>Campground</sym>
  </wpt>
  <wpt lat="38.934105" lon="-79.731492">
    <name>Bickle Knob Tower (spur)</name>
    <cmt>Day 1 mi 8.2 / trip mi 8.2. Short out-and-back spur to the fire tower.</cmt>
    <desc>Day 1 mi 8.2 / trip mi 8.2. Short out-and-back spur to the fire tower.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="38.617083" lon="-79.807539">
    <name>Hike-a-bike to Little River Rd</name>
    <cmt>Day 3 mi 24.7 / trip mi 126.4. Short 100 yd path from the rail trail over to the road at Burner.</cmt>
    <desc>Day 3 mi 24.7 / trip mi 126.4. Short 100 yd path from the rail trail over to the road at Burner.</desc>
    <sym>Danger Area</sym>
  </wpt>
